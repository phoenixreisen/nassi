
PREAMBLE
"""Preamble 
Every line/paragraph starts with its expected step.
"""

1 one

"""2 two"""

SWITCH """3 three""" {
    CASE 3.1 three point one { 
        3.1.1 three point one point one
        3.1.2 three point one point two
    }
    CASE 3.2 three point two {
        3.2.1 three point two point one
    }
    DEFAULT 3.3 three point three {
        3.3.1 three point three point one
    }

}

4 four
