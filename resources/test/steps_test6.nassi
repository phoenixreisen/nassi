
PREAMBLE
"""Preamble 
Every line/paragraph starts with its expected step.
"""

1 text

"""2 text"""

SWITCH 3 switch-cond {
  CASE 3.1 case-cond { 
    3.1.1 text
    SWITCH 3.1.2 switch-cond {
      CASE 3.1.2.1 case-cond { 
        3.1.2.1.1 text
        3.1.2.1.2 text
      }
      CASE 3.1.2.2 case-cond {
        3.1.2.2.1 text
      }
      DEFAULT 3.1.2.3 default-cond {
        3.1.2.3.1 text
      }
    }
    3.1.3 text  
  }
  CASE 3.2 case-cond { 
    3.2.1 text
    SWITCH 3.2.2 switch-cond {
      CASE 3.2.2.1 case-cond { 
        3.2.2.1.1 text
        3.2.2.1.2 text
      }
      CASE 3.2.2.2 case-cond {
        3.2.2.2.1 text
      }
      DEFAULT 3.2.2.3 default-cond {
        3.2.2.3.1 text
      }
    }
    3.2.3 text  
  }
  DEFAULT 3.3 default-cond { 
    3.3.1 text
    SWITCH 3.3.2 switch-cond {
      CASE 3.3.2.1 case-cond { 
        3.3.2.1.1 text
        3.3.2.1.2 text
      }
      CASE 3.3.2.2 case-cond {
        3.3.2.2.1 text
      }
      DEFAULT 3.3.2.3 default-cond {
        3.3.2.3.1 text
      }
    }
    3.3.3 text  
  }
}

4 four
